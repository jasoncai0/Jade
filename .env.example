# Copy to .env and fill in. Environment variables take precedence over this file.
DEEPSEEK_API_KEY=sk-your-key-here
# Strict tools use DeepSeek beta; an official api.deepseek.com base is routed
# to /beta/chat/completions automatically. Custom gateways are not rewritten.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# No hard model-turn limit by default. Set a positive cap if you want one.
AGENT_PERMISSION_MODE=balanced
AGENT_MAX_STEPS=0
# Safety valve for long runs; 0 disables it. The loop guard still stops repeated
# identical tool calls.
AGENT_TOKEN_BUDGET=2000000
AGENT_PORT=8080
AGENT_HOST=127.0.0.1

# Per-tool limits
AGENT_MAX_TOOL_CALLS_PER_STEP=8
AGENT_COMMAND_TIMEOUT_SECONDS=120
AGENT_CONTEXT_CHAR_BUDGET=120000
AGENT_AUTO_VERIFY=true

# OS command sandbox. off (default) = local execution, no write jail.
# auto = use the macOS write jail when available; required refuses to start
# when sandbox-exec is unavailable. Network is denied in the jail unless enabled.
AGENT_SANDBOX=off
AGENT_SANDBOX_NETWORK=false

# Optional path overrides
# AGENT_SKILLS_DIR=skills
# AGENT_WORKSPACES_DIR=agent-workspaces
