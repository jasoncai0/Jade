# Copy to .env and fill in. Environment variables take precedence over this file.
DEEPSEEK_API_KEY=sk-your-key-here
# Strict tools use DeepSeek beta; an official api.deepseek.com base is routed
# to /beta/chat/completions automatically. Custom gateways are not rewritten.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# No hard model-turn limit by default. Set a positive cap if you want one.
AGENT_PERMISSION_MODE=balanced
AGENT_MAX_STEPS=0
# Optional hard budget for unattended runs; 0 = unlimited (the default).
# Interactive long tasks should use cost/usage monitoring, not a total token cap.
AGENT_TOKEN_BUDGET=0
AGENT_PORT=8080
AGENT_HOST=127.0.0.1
# Required when AGENT_HOST is non-loopback; optional bearer token on loopback.
# AGENT_WEB_TOKEN=

# Per-tool limits
AGENT_MAX_TOOL_CALLS_PER_STEP=8
AGENT_COMMAND_TIMEOUT_SECONDS=120
AGENT_CONTEXT_CHAR_BUDGET=120000
AGENT_CONTEXT_TOKEN_BUDGET=30000
AGENT_AUTO_VERIFY=true
# Independent goal review before a run can succeed; costs one extra model call.
AGENT_GOAL_MODE=true

# Execution sandbox backend: local (default) or docker (optional container plugin).
AGENT_SANDBOX_BACKEND=local
# OS command sandbox for local backend. off (default) = local execution, no write jail.
# auto = use the macOS write jail when available; required refuses to start
# when sandbox-exec is unavailable. Network is denied in the jail unless enabled.
AGENT_SANDBOX=off
AGENT_SANDBOX_NETWORK=false
# Optional Docker sandbox settings (used only when AGENT_SANDBOX_BACKEND=docker)
AGENT_SANDBOX_DOCKER_IMAGE=jade-sandbox:1
AGENT_SANDBOX_DOCKER_NETWORK=off
AGENT_SANDBOX_DOCKER_MEMORY=2g
AGENT_SANDBOX_DOCKER_CPUS=2
AGENT_SANDBOX_DOCKER_PIDS=256
AGENT_SANDBOX_DOCKER_PREVIEW_PORTS=8080

# MCP client. Create mcp.json from mcp.json.example; it is gitignored.
# JADE_MCP_CONFIG=mcp.json
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# Optional path overrides
# AGENT_SKILLS_DIR=skills
# AGENT_WORKSPACES_DIR=agent-workspaces


# Durable history (MySQL 8.4 via docker compose)
JADE_MYSQL_URL=jdbc:mysql://127.0.0.1:3307/jade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JADE_MYSQL_USER=jade
JADE_MYSQL_PASSWORD=jade_dev_password

# Long-term memory (Mem0 OSS sidecar). Default on; missing sidecar falls back to no-op.
AGENT_MEMORY_MODE=on
AGENT_MEMORY_URL=http://127.0.0.1:8888
AGENT_MEMORY_PROVIDER=mem0-oss
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_USER_ID=jade-local-user
# Optional logical project key; defaults to SHA-256 of AGENT_WORKSPACES_DIR.
# AGENT_MEMORY_PROJECT_ID=
AGENT_MEMORY_TOP_K=5
AGENT_MEMORY_RECALL_TIMEOUT_MS=500
AGENT_MEMORY_WRITE_TIMEOUT_MS=2000
AGENT_MEMORY_TELEMETRY=true
# Mem0 Hybrid Admission v2: hybrid (default) | llm | heuristic | off
AGENT_MEMORY_ADMISSION=hybrid
AGENT_MEMORY_AUTO_THRESHOLD=0.85
AGENT_MEMORY_REVIEW_THRESHOLD=0.60
AGENT_MEMORY_MAX_WRITES_PER_RUN=3
AGENT_MEMORY_ADMISSION_TIMEOUT_MS=2000

# Team mode default for newly created root sessions (off by default)
AGENT_TEAM_ENABLED=false
